<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.urbancanopy</groupId>
    <artifactId>urban-canopy</artifactId>
    <version>1.0.0</version>
    <name>UrbanCanopy</name>
    <description>
        Urban Tree Plantation Plan to Estimate Annual Carbon Sequestration and Improve Air Quality —
        a decision-support system that estimates the environmental impact of planned urban
        plantations using curated scientific reference values.
    </description>
    <url>https://github.com/ASWIN-SENTHILKUMAR2006/urbancanopy</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency versions not managed by the Spring Boot parent -->
        <openpdf.version>1.4.2</openpdf.version>
    </properties>

    <dependencies>

        <!-- ============================ WEB LAYER ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (JSR-380) for request DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================= SECURITY ============================ -->
        <!--
             Added in Phase 12, deliberately not before. Introducing it earlier would have
             meant writing a permissive stand-in configuration and deleting it later; the
             application instead depended on the CurrentUserProvider seam, so switching to
             real authentication changes that one implementation and nothing else.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
             In-memory database for repository slice tests.

             The Flyway migrations are deliberately MySQL-specific (InnoDB, utf8mb4 collation,
             a JSON column), so they are NOT run against H2. The slice tests generate the
             schema from the JPA entities instead, which is what makes them worth having: they
             prove the ~20 hand-written JPQL queries parse and return what they claim. Whether
             the entities match the migrated schema is a different question, and one the
             application already answers on every real start-up through ddl-auto=validate.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================ REPORTING ============================ -->
        <!--
             OpenPDF rather than iText 7. iText 7 is AGPL: linking it into an application
             that is distributed or offered over a network obliges the whole application to
             be offered under the AGPL too, or a commercial licence to be bought. OpenPDF is
             the LGPL/MPL fork of the last Apache-licensed iText line — safe to submit and
             safe to commercialise (architecture §9).
        -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- ========================= PERSISTENCE LAYER ======================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Versioned schema migrations; ddl-auto stays on 'validate' -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ======================= OPERATIONS / TOOLING ====================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            NOTE (Phase 5): spring-boot-starter-security is deliberately ABSENT.
            Authentication is scheduled for Phase 12. Until then the application runs
            open, and services obtain the caller through the CurrentUserProvider seam
            (com.urbancanopy.common.security) so that adding security later requires
            no change to any service or controller.

            NOTE (Phase 5): OpenPDF is added in Phase 11 (PDF reporting).
        -->

        <!-- ============================== TESTING ============================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>urban-canopy</finalName>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Emit Java 21 bytecode even though the local JDK is newer -->
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
